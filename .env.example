SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Opcao 1: URL unica do banco.
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco?sslmode=require

# Opcao 2: variaveis separadas.
# DB_ENGINE=postgresql
# DB_NAME=edunex
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=prefer

# Fallback local quando DATABASE_URL/DB_HOST nao existem.
SQLITE_NAME=db.sqlite3
